# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=

# Optional — port the local server listens on.
PORT=4000

# Image generation (Gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override:
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Vercel Blob storage for generated art (required on Vercel; locally the
# server writes uploads/generated/ instead). From the Vercel dashboard:
BLOB_READ_WRITE_TOKEN=
# Optional — the host your Blob store serves from, e.g.
# abc123xyz.public.blob.vercel-storage.com; derived from the token when unset.
# Only pictures on this host (under farsh-art/) are accepted as ours.
# BLOB_PUBLIC_HOST=

# Order notifications (Resend). Orders are emailed to you — this email IS the
# order record, so without these two an order FAILS loudly rather than being
# silently lost.
#
# No domain yet? Sign up at https://resend.com, create an API key, and leave
# ORDER_EMAIL_FROM unset: Resend's shared onboarding sender can email your own
# account address without a verified domain. To email customers you will need
# your own domain verified in Resend.
RESEND_API_KEY=
ORDER_EMAIL_TO=
# Optional — needs a domain verified in Resend:
# ORDER_EMAIL_FROM=Farsh! orders <orders@yourdomain.com>

# Signs the order email's "Review & confirm payment" link — a long random
# string (e.g. `openssl rand -hex 32`). Required for any order that carries a
# payment screenshot; without it, composing that order's email fails loudly
# rather than sending an order nobody can ever confirm payment on.
# Also signs the scene lines the writer hands to the illustrator, so the plate
# routes only illustrate stories we wrote. Required for illustrations.
ORDER_CONFIRM_SECRET=

# Optional — the public URL the confirm link should point back at. Vercel
# deployments fall back to VERCEL_URL automatically; set this for a custom
# domain, or leave it to default to localhost when running locally.
# APP_BASE_URL=https://yourdomain.com
