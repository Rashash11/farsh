# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=

# Optional — port the local server listens on.
PORT=4000

# Image generation (Gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override:
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Vercel Blob storage for generated art (required on Vercel; locally the
# server writes uploads/generated/ instead). From the Vercel dashboard:
BLOB_READ_WRITE_TOKEN=

# Order notifications (Resend). Orders are emailed to you — this email IS the
# order record, so without these two an order FAILS loudly rather than being
# silently lost.
#
# No domain yet? Sign up at https://resend.com, create an API key, and leave
# ORDER_EMAIL_FROM unset: Resend's shared onboarding sender can email your own
# account address without a verified domain. To email customers you will need
# your own domain verified in Resend.
RESEND_API_KEY=
ORDER_EMAIL_TO=
# Optional — needs a domain verified in Resend:
# ORDER_EMAIL_FROM=Farsh! orders <orders@yourdomain.com>
